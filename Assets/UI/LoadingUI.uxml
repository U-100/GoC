<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GoCStyles.uss?fileID=7433441132597879392&amp;guid=80a2e23be22fad8418ac023d59da84e2&amp;type=3#GoCStyles" />
    <ui:VisualElement style="flex-grow: 1; justify-content: center; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;">
        <ui:Label text="LOADING..." display-tooltip-when-elided="true" class="goc-text" style="-unity-font-style: italic; font-size: 48px;" />
        <ui:VisualElement style="padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; flex-shrink: 0; max-height: 80px; min-height: 80px; border-left-color: rgba(73, 229, 242, 255); border-right-color: rgba(73, 229, 242, 255); border-top-color: rgba(73, 229, 242, 255); border-bottom-color: rgba(73, 229, 242, 255); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px;">
            <ui:VisualElement name="ProgressBar" style="height: 100%; width: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; background-color: rgba(73, 229, 242, 255); border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px;" />
        </ui:VisualElement>
        <ui:Label text="0%" display-tooltip-when-elided="true" class="goc-text" style="-unity-font-style: italic; -unity-text-align: upper-right; font-size: 48px;" />
    </ui:VisualElement>
</ui:UXML>

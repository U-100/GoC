TextField TextInput#unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.goc-border {
    border-left-color: rgb(80, 120, 231);
    border-right-color: rgb(80, 120, 231);
    border-top-color: rgb(80, 120, 231);
    border-bottom-color: rgb(80, 120, 231);
}

.goc-text {
    color: rgb(208, 214, 231);
}

.goc-button {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    font-size: 42px;
    text-shadow: 1px 1px 1px rgb(51, 93, 128);
    border-left-color: rgb(80, 120, 231);
    border-right-color: rgb(80, 120, 231);
    border-top-color: rgb(80, 120, 231);
    border-bottom-color: rgb(80, 120, 231);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    color: rgb(231, 222, 208);
}

.goc-border {
    border-radius: 8px;
    border-left-color: rgb(80, 120, 231);
    border-right-color: rgb(80, 120, 231);
    border-top-color: rgb(80, 120, 231);
    border-bottom-color: rgb(80, 120, 231);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.goc-text {
    color: rgb(80, 120, 231);
    font-size: 28px;
}

.goc-button {
    border-radius: 8px;
    background-color: rgb(64, 64, 64);
    font-size: 42px;
    border-left-color: rgb(80, 120, 231);
    border-right-color: rgb(80, 120, 231);
    border-top-color: rgb(80, 120, 231);
    border-bottom-color: rgb(80, 120, 231);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    color: rgb(80, 120, 231);
    -unity-text-outline-color: rgb(80, 120, 231);
    -unity-text-outline-width: 3px;
}

.goc-dropdown {
    border-radius: 8px;
    background-color: rgb(64, 64, 64);
    font-size: 42px;
    border-left-color: rgb(80, 120, 231);
    border-right-color: rgb(80, 120, 231);
    border-top-color: rgb(80, 120, 231);
    border-bottom-color: rgb(80, 120, 231);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    color: rgb(80, 120, 231);
    -unity-text-outline-color: rgb(80, 120, 231);
    -unity-text-outline-width: 3px;
}

.unity-base-dropdown__container-outer {
    border-radius: 8px;
    background-color: rgb(64, 64, 64);
    font-size: 42px;
    border-left-color: rgb(80, 120, 231);
    border-right-color: rgb(80, 120, 231);
    border-top-color: rgb(80, 120, 231);
    border-bottom-color: rgb(80, 120, 231);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    color: rgb(80, 120, 231);
    -unity-text-outline-color: rgb(80, 120, 231);
    -unity-text-outline-width: 3px;
}

.goc-header-text {
    font-size: 148px;
    -unity-text-outline-color: rgba(140, 80, 231, 0.5);
    -unity-text-outline-width: 8px;
    color: rgb(80, 120, 231);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.goc-subheader-text {
    font-size: 84px;
    color: rgb(80, 120, 231);
    -unity-text-outline-color: rgb(80, 120, 231);
    -unity-text-outline-width: 8px;
}

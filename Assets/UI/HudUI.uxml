<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GoCStyles.uss?fileID=7433441132597879392&amp;guid=80a2e23be22fad8418ac023d59da84e2&amp;type=3#GoCStyles" />
    <ui:VisualElement data-source-type="GoC.Hud, Assembly-CSharp" style="flex-grow: 1;">
        <ui:TextField picking-mode="Ignore" name="ImmediateScript" multiline="true" vertical-scroller-visibility="Auto" class="goc-text goc-border" style="flex-grow: 1; min-height: 320px; background-color: rgba(255, 255, 255, 0.25);">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="script" binding-mode="TwoWay" />
            </Bindings>
        </ui:TextField>
        <ui:VisualElement style="flex-grow: 3;">
            <ui:TextField picking-mode="Ignore" multiline="true" name="Log" focusable="false" readonly="true" class="goc-text" style="flex-grow: 1; align-items: flex-start;">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="logText" binding-mode="ToTarget" />
                </Bindings>
            </ui:TextField>
            <ui:Button tabindex="-1" text="Go (Ctrl + Enter)" display-tooltip-when-elided="true" name="Go" class="goc-button" style="flex-shrink: 1; position: absolute; right: 0; top: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

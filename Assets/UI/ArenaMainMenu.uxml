<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GoCStyles.uss?fileID=7433441132597879392&amp;guid=80a2e23be22fad8418ac023d59da84e2&amp;type=3#GoCStyles" />
    <engine:VisualElement style="flex-grow: 1; position: absolute; width: 50%; height: 50%; align-self: center; top: 25%;">
        <engine:VisualElement style="flex-grow: 1;">
            <engine:Label text="Game of Code Arena" class="goc-header-text" style="flex-grow: 1; overflow: visible; white-space: nowrap; text-shadow: 10px 8px 10px rgba(140, 80, 231, 0.5); -unity-text-outline-color: rgb(80, 120, 231); -unity-text-align: upper-center;" />
        </engine:VisualElement>
        <engine:Button text="Play Code vs. AI" name="PrepareCodeVsAIButton" class="goc-button" />
        <engine:Button text="Quit" name="QuitButton" class="goc-button" />
        <engine:Label class="goc-text" style="flex-grow: 1; overflow: visible; position: absolute; top: 135%; left: 135%;">
            <Bindings>
                <engine:DataBinding property="text" data-source-path="version" binding-mode="ToTarget" />
            </Bindings>
        </engine:Label>
    </engine:VisualElement>
</engine:UXML>

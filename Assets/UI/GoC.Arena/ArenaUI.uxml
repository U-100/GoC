<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="ArenaMainMenu" src="project://database/Assets/UI/GoC.Arena/ArenaMainMenu.uxml?fileID=9197481963319205126&amp;guid=56715390a5df2414f9baeb523fedffe1&amp;type=3#ArenaMainMenu" />
    <engine:Template name="ArenaPlayMenu" src="project://database/Assets/UI/GoC.Arena/ArenaCodeVsAIMenu.uxml?fileID=9197481963319205126&amp;guid=b9cd633dd760a584683f0a15ce1fe009&amp;type=3#ArenaCodeVsAIMenu" />
    <engine:Instance template="ArenaMainMenu" name="MainMenu" data-source-type="GoC.Arena.ArenaViewModel, Assembly-CSharp" style="position: absolute; width: 100%; height: 100%;">
        <Bindings>
            <engine:DataBinding property="style.display" data-source-path="isInMainMenu" binding-mode="ToTarget" />
        </Bindings>
    </engine:Instance>
    <engine:Instance template="ArenaPlayMenu" name="CodeVsAIMenu" data-source-type="GoC.Arena.ArenaViewModel, Assembly-CSharp" style="width: 100%; height: 100%; position: absolute;">
        <Bindings>
            <engine:DataBinding property="style.display" data-source-path="isInCodeVsAIMenu" binding-mode="ToTarget" />
        </Bindings>
    </engine:Instance>
</engine:UXML>
